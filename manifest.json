{
  "manifest_version": 2,
  "name": "PeelScout",
  "description": "Removes email-security URL wrappers in place and shows triage insights, nested EML content, image previews, QR and calendar-invite URLs in a sidebar, with offline ports of Sublime Security rules.",
  "version": "1.9.0",
  "author": "ExploitBlock",
  "browser_specific_settings": {
    "gecko": {
      "id": "peelscout@exploitblock.local",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
  "permissions": ["messagesRead", "messagesModify", "menus", "clipboardWrite", "storage"],
  "optional_permissions": ["https://*/*"],
  "background": {
    "scripts": ["inflate-zlib.js", "unwrap.js", "phones.js", "sublime-data.js", "sublime-rules.js", "rules.js", "forwards.js", "pdfscan.js", "signals.js", "ics.js", "nested.js", "ocr.js", "background.js"]
  },
  "message_display_action": {
    "default_title": "PeelScout",
    "default_popup": "popup.html"
  }
}
